# Configuración del nodo local de Pumaverso POS.
# Copia este archivo como `.env` y ajusta los valores para tu entorno.
# El archivo `.env` no se sube al repositorio (está en .gitignore).
# Variables definidas en apps/tienda/src/pumaverso_tienda/config.py

# Nombre que muestra la API en la documentación (/docs)
APP_NAME="Pumaverso POS - Nodo local"

# Versión de la aplicación
APP_VERSION=0.1.0

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Ruta del archivo SQLite de la sucursal (relativa a la carpeta desde donde se ejecuta)
DATABASE_PATH=data/pumaverso.db

# Identidad del nodo. Forma parte de la identidad de cada evento, así que no debe
# cambiar después de registrar ventas. Letras, números, guion y guion bajo (máx. 32).
SUCURSAL_ID=S001

# En V1 hay una sola caja por sucursal (decisión 0004).
CAJA_ID=C01

# Dirección del servidor central y tamaño máximo de cada lote de eventos.
CENTRAL_URL=http://127.0.0.1:8001
SYNC_LOTE_MAXIMO=100

# Sincronización automática en segundo plano (decisión 0007).
SYNC_AUTOMATICA=true
# Cada cuánto sincroniza cuando todo va bien.
SYNC_INTERVALO_SEGUNDOS=60
# Tope de espera entre reintentos cuando central no responde.
SYNC_ESPERA_MAXIMA_SEGUNDOS=300

# --- Servidor central (apps/central) ---
# Base de datos de desarrollo; coincide con docker-compose.yml.
CENTRAL_DATABASE_URL=postgresql://pumaverso:pumaverso@127.0.0.1:5432/pumaverso_central
# Procesamiento automático de la cola de eventos (decisión 0007).
CENTRAL_COLA_AUTOMATICA=true
CENTRAL_COLA_INTERVALO_SEGUNDOS=5
CENTRAL_COLA_LOTE=50
# Las pruebas de central usan otra base, que se crea sola. No la apuntes a la de desarrollo.
# CENTRAL_TEST_DATABASE_URL=postgresql://pumaverso:pumaverso@127.0.0.1:5432/pumaverso_central_test
