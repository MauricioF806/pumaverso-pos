# Configuración del nodo local de Pumaverso POS.
# Copia este archivo como `.env` y ajusta los valores para tu entorno.
# El archivo `.env` no se sube al repositorio (está en .gitignore).
# Variables definidas en apps/tienda/src/pumaverso_tienda/config.py

# Nombre que muestra la API en la documentación (/docs)
APP_NAME="Pumaverso POS - Nodo local"

# Versión de la aplicación
APP_VERSION=0.1.0

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Ruta del archivo SQLite de la sucursal (relativa a la carpeta desde donde se ejecuta)
DATABASE_PATH=data/pumaverso.db

# Identidad del nodo. Forma parte de la identidad de cada evento, así que no debe
# cambiar después de registrar ventas. Letras, números, guion y guion bajo (máx. 32).
SUCURSAL_ID=S001

# En V1 hay una sola caja por sucursal (decisión 0004).
CAJA_ID=C01

# Dirección del servidor central y tamaño máximo de cada lote de eventos.
CENTRAL_URL=http://127.0.0.1:8001
SYNC_LOTE_MAXIMO=100

# Llave de esta sucursal para hablar con central (decisión 0010). Mínimo 32 caracteres.
# scripts/cargar_datos_demo.py la registra en central. Este valor es solo para
# desarrollo: en una sucursal real, la genera central con PUT /sucursales/{id}/llave.
LLAVE_CENTRAL=desarrollo-llave-sucursal-S001-cambiala

# Sincronización automática en segundo plano (decisión 0007).
SYNC_AUTOMATICA=true
# Cada cuánto sincroniza cuando todo va bien.
SYNC_INTERVALO_SEGUNDOS=60
# Tope de espera entre reintentos cuando central no responde.
SYNC_ESPERA_MAXIMA_SEGUNDOS=300

# Orígenes del navegador que pueden llamar a la API de la tienda (decisión 0008).
# Lista JSON. Por defecto, el servidor de desarrollo de Vite.
CORS_ORIGENES=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Servidor central (apps/central) ---
# Base de datos de desarrollo; coincide con docker-compose.yml.
CENTRAL_DATABASE_URL=postgresql://pumaverso:pumaverso@127.0.0.1:5432/pumaverso_central
# Llave de administración de central (decisión 0010). Mínimo 32 caracteres. Sin ella
# nadie puede dar de alta usuarios, productos ni llaves. Este valor es solo para
# desarrollo; para generar una: python -c "import secrets; print(secrets.token_urlsafe(32))"
CENTRAL_LLAVE_ADMIN=desarrollo-llave-administracion-cambiala
# Límite de tasa por sucursal (decisión 0012): ráfaga y recarga por minuto. 0 = sin límite.
CENTRAL_LIMITE_RAFAGA=60
CENTRAL_LIMITE_POR_MINUTO=180
# Procesamiento automático de la cola de eventos (decisión 0007).
CENTRAL_COLA_AUTOMATICA=true
CENTRAL_COLA_INTERVALO_SEGUNDOS=5
CENTRAL_COLA_LOTE=50
# Detección de inventario fantasma (decisión 0009).
CENTRAL_FANTASMA_AUTOMATICO=true
CENTRAL_FANTASMA_INTERVALO_SEGUNDOS=900
CENTRAL_FANTASMA_ZONA_HORARIA=America/Mexico_City
# Franjas de N horas; N debe dividir 24.
CENTRAL_FANTASMA_HORAS_POR_FRANJA=4
# Días de historia para calcular el ritmo normal y mínimo de días con ventas en la franja.
CENTRAL_FANTASMA_DIAS_HISTORIA=28
CENTRAL_FANTASMA_DIAS_MINIMOS=7
# Qué tan raro debe ser vender tan poco para sospechar (0.01 = menos de 1 de cada 100 veces).
CENTRAL_FANTASMA_SIGNIFICANCIA=0.01
# Horas sin conteo antes de escalar la sospecha al responsable regional.
CENTRAL_FANTASMA_HORAS_PARA_ESCALAR=24
# Las pruebas de central usan otra base, que se crea sola. No la apuntes a la de desarrollo.
# CENTRAL_TEST_DATABASE_URL=postgresql://pumaverso:pumaverso@127.0.0.1:5432/pumaverso_central_test
